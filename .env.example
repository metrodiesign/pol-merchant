# Merchant BFF API origin — Next.js proxy rewrites สำหรับ development เท่านั้น.
# same-origin: SPA(https://localhost:3002) เรียก API path -> Next proxy ไป backend; cookie ผูก origin ของ SPA.
# prod: เว้นว่าง — reverse proxy เสิร์ฟ SPA + API origin เดียวกันอยู่แล้ว. ไม่ใช่ secret.
ADMIN_API_ORIGIN=https://localhost:5001
NEXT_PUBLIC_API_ORIGIN=https://localhost:5001
