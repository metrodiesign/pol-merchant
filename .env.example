# Admin BFF API origin — Next.js proxy rewrite (/admin/* -> backend) dev เท่านั้น.
# same-origin: SPA(5200) เรียก /admin/* -> Next proxy ไป backend; cookie ผูก origin ของ SPA.
# prod: เว้นว่าง — reverse proxy เสิร์ฟ SPA + API origin เดียวกันอยู่แล้ว. ไม่ใช่ secret.
ADMIN_API_ORIGIN=http://localhost:5100
